# Obsidian vault — read-only with Ollama embeddings
# MARKDOWN_VAULT_MCP_SERVER_NAME=obsidian-vault
# Appended to the generated guidance, which already covers the tool workflows
# and the read-only announcement. Keep this to what is specific to this vault.
MARKDOWN_VAULT_MCP_INSTRUCTIONS_EXTRA=Personal Obsidian knowledge base: notes, journal entries, and project references. Semantic search is configured, so mode='hybrid' gives the best results.
MARKDOWN_VAULT_MCP_SOURCE_DIR=/home/user/Obsidian
MARKDOWN_VAULT_MCP_READ_ONLY=true
MARKDOWN_VAULT_MCP_EXCLUDE=.obsidian/**,.trash/**,_templates/**

# Periodic git sync (ff-only). Default is 600s; set to 0 to disable.
# MARKDOWN_VAULT_MCP_GIT_PULL_INTERVAL_S=600
# Optional managed mode for pull-only startup sync from a remote checkout.
# MARKDOWN_VAULT_MCP_GIT_REPO_URL=https://github.com/your-org/your-vault.git

# Attachments: default list allows common document and image formats.
# Uncomment to restrict to specific extensions, or use * for all non-.md files.
# MARKDOWN_VAULT_MCP_ATTACHMENT_EXTENSIONS=pdf,png,jpg,jpeg
# Maximum attachment size in MB returned by read() / accepted by write().
# Default 1 MB (lowered from 10 MB to keep LLM context bounded).
# Set to 0 to disable the limit.
# MARKDOWN_VAULT_MCP_MAX_ATTACHMENT_SIZE_MB=1
# Maximum bytes returned by full-document read() for .md files.
# Default 262144 (256 KB).  Use read(path, section=...) for partial reads.
# Set to 0 to disable the limit.
# MARKDOWN_VAULT_MCP_MAX_NOTE_READ_BYTES=262144

# Optional: override Claude app domain for MCP Apps iframe sandboxing (auto-computed from BASE_URL)
# MARKDOWN_VAULT_MCP_APP_DOMAIN=

MARKDOWN_VAULT_MCP_EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
MARKDOWN_VAULT_MCP_OLLAMA_MODEL=nomic-embed-text

# --- Search ranking and snippet truncation ---
# Maximum sections returned per file (field collapsing). 0 rejected.
# Per-call override on search/get_similar; get_context defaults to 1.
# MARKDOWN_VAULT_MCP_CHUNKS_PER_FILE=2

# Snippet word budget. 0 = no truncation, full chunk. Per-call override.
# MARKDOWN_VAULT_MCP_SNIPPET_WORDS=200

# Length downweight strength. 0 disables. Operator-only (no per-call override).
# MARKDOWN_VAULT_MCP_LENGTH_DOWNWEIGHT_ALPHA=0.25

# Adaptive chunker word threshold. Reindex required when changed.
# Set very high (e.g. 100000) to disable adaptive splitting.
# MARKDOWN_VAULT_MCP_MAX_CHUNK_WORDS=400

# Adaptive chunker character cap (bounds token-dense chunks: CJK, code, tables).
# Unset = safe default min(1500, round(context x 2.8)); a small-context model
# clamps down, an unknown context falls back to 1500. Set a positive value to
# force an exact cap; set -1 to scale with the model's full context with no
# ceiling (can OOM the fastembed/ONNX path on a long-context model). Reindex
# required when changed.
# MARKDOWN_VAULT_MCP_MAX_CHUNK_CHARS=2000

# Words of overlap between adjacent fragments of an oversize section (default 40;
# 0 disables). Applies to new/re-indexed notes; reindex to apply everywhere.
# MARKDOWN_VAULT_MCP_CHUNK_OVERLAP_WORDS=40

# --- Curated ranking and searchable frontmatter ---
# Frontmatter key used as the note title (falls back to `title`, first H1, then
# filename stem). Changing it cold-rebuilds the index once on next startup.
# MARKDOWN_VAULT_MCP_TITLE_FIELD=title

# Comma-separated frontmatter fields whose text becomes keyword-searchable via a
# trailing FTS `summary` column. Setting this also enriches embeddings (title +
# heading + field preamble), re-embedding the vault once on next startup.
# Unset/empty = inherits INDEXED_FIELDS; set explicitly to diverge, or `none`
# for no searchable fields at all.
# MARKDOWN_VAULT_MCP_SEARCHABLE_FIELDS=summary

# Prepend the note title and chunk heading to embedding input (re-embeds once on
# next startup). Independent of SEARCHABLE_FIELDS, which already triggers the
# enriched embedding format.
# MARKDOWN_VAULT_MCP_EMBED_CONTEXT=false

# Per-folder rank multipliers (`prefix:weight,...`, weights > 0; deepest prefix
# wins), applied to all search modes. Empty = disabled.
# MARKDOWN_VAULT_MCP_FOLDER_WEIGHTS=sessions:0.5,curated:1.5

# Per-column BM25 weights (`column:weight,...`, weights >= 0). Columns: path,
# title, folder, heading, content, summary. Unset = all 1.0.
# MARKDOWN_VAULT_MCP_FTS_WEIGHTS=title:3,summary:2
